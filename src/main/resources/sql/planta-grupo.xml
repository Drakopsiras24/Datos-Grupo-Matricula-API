<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.mineduc.sidep.datosgrupomatriculaapi.mappers.PlantaGrupoMapper">

    <insert id="save" parameterType="cl.mineduc.sidep.datosgrupomatriculaapi.entities.PlantaGrupoEntity">
        INSERT INTO planta_grupo (fk_plgr_planta_id, fk_plgr_grupo_id, fk_plgr_rol_grupo_id, plgr_fecha_creacion)
        VALUES (#{planta},
                #{grupo},
                #{rol},
                current_timestamp);
    </insert>
</mapper>
