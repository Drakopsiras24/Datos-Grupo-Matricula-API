<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cl.mineduc.sidep.datosgrupomatriculaapi.mappers.FuncionarioMapper">

    <select id="findByPersonaId" resultType="java.lang.Long">
        SELECT pk_fnci_id_funcionario
        FROM funcionario
        WHERE fk_fnci_id_persona = #{persona}
    </select>

</mapper>